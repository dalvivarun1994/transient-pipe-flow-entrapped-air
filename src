def darcy_friction_colebrook(Re, epsilon, D, max_iter=20, tol=1e-6):
    """
    Solves the implicit Colebrook equation exactly using Newton-Raphson iteration.

    """
    # 1. Check for laminar flow
    if Re < 2300:
        return 64.0 / Re

    relative_roughness = epsilon / D

    # 2. Generate an excellent initial guess using Haaland
    f_guess = (-1.8 * np.log10((relative_roughness / 3.7)**1.11 + 6.9 / Re))**-2
    x = 1.0 / np.sqrt(f_guess) # Transform variable to x = 1/sqrt(f) for numerical stability

    # 3. Newton-Raphson Loop
    for _ in range(max_iter):
        # Interior log term
        arg = (relative_roughness / 3.7) + (2.51 * x / Re)

        # Function evaluation: F(x) = 0
        F = x + 2.0 * np.log10(arg)

        # Derivative evaluation: dF/dx
        dF = 1.0 + (2.0 / np.log(10.0)) * (2.51 / Re) / arg

        # Update step
        dx = F / dF
        x -= dx

        # Convergence check
        if abs(dx) < tol:
            break


    return 1.0 / (x ** 2)

def custom_newton_raphson(func, X_guess, args, xtol=1e-6, maxiter=150, relaxation=0.5):
    """
    Custom Newton-Raphson solver
    """
    X = X_guess.copy()
    N = len(X)
    eps = 1e-6  # Finite difference perturbation step size

    # Extract structural parameter values for engineering scaling
    params = args[3]  # args is (X_old, dt, t, params)
    Num_Nodes = params['Num_Nodes']
    P_ref = params['P_tank']            # High pressure scaling reference (~4x10^5)
    M_ref = 1.0                         # Expected transient mass flow scale reference (1 kg/s)
    V_ref = params['V_node']            # Grid cell volume scaling reference

    # 1. Pre-build the Weight/Scaling Vector (W) matching the layout of your residual vector
    # Layout matches 'residuals' array indices constructed inside system_residuals
    W = np.ones(N)

    # Momentum Equation Index Range: [0 to Num_Nodes-2] -> Scale by typical pressure-force delta
    # Since Momentum residual shares units with pressure drop * Area / dx, we scale by P_ref
    W[0 : Num_Nodes - 1] = 1.0 / P_ref

    # Continuity Equation Index Range: [Num_Nodes-1 to 2*Num_Nodes-3] -> Scale by mass flow reference
    W[Num_Nodes - 1 : 2 * Num_Nodes - 3] = 1.0 / M_ref

    # Boundary & Kinematics Conditions at the end:
    # Node 0 Pressure Boundary Condition -> Scale by Pressure reference
    W[2 * Num_Nodes - 3] = 1.0 / P_ref

    # Node N-1 Air Pocket Boundary Condition -> Scale by Pressure reference
    W[2 * Num_Nodes - 2] = 1.0 / P_ref

    # Dynamic Volume Kinematics Boundary Condition -> Scale by Node Volume reference
    W[2 * Num_Nodes - 1] = 1.0 / V_ref

    # 2. Main Iteration Loop
    for iteration in range(1, maxiter + 1):
        # Evaluate raw baseline residuals from your physical equations
        R = func(X, *args)

        # Apply the scaling weights to normalize the residuals
        """weighted_R = R * W"""
        #wrms_error = np.sqrt(np.mean(R**2))
        abs_error = np.max(np.abs(R))

        # Print the normalized tracking metrics to the log terminal
        #print(f"  --> NR Iteration {iteration:3d} | Weighted RMS Error: {wrms_error:.4e}")

        # Exit check based on uniform, dimensionless threshold target
        if abs_error < xtol:
            return True, X, iteration

        # 3. Numerically construct the Jacobian Matrix (J) via Finite Difference
        J = np.zeros((N, N))
        for j in range(N):
            # 1. Calculate an adaptive epsilon based on the magnitude of the variable
            # For a scaled variable near 1.0, this yields a perfect perturbation of ~1e-6
            # If the variable is exactly 0.0, it safely falls back to 1e-6
            #eps_adaptive = 1e-6 * (abs(X[j]) + 1.0)
            X_pert = X.copy()
            X_pert[j] += eps
            R_pert = func(X_pert, *args)
            J[:, j] = (R_pert - R) / eps

        # 4. Solve the matrix system J * delta_X = -R
        try:
            # Tikhonov diagonal regularizer to prevent singular matrix collapse
            # if physical decoupling occurs temporarily during search tweaks
            J += np.eye(N) * 1e-9
            delta_X = np.linalg.solve(J, -R)
        except np.linalg.LinAlgError:
            print("  [Warning] Jacobian matrix is singular! Aborting current time step.")
            return False, X, iteration

        # delta_X_clipped = np.clip(delta_X, -0.5, 0.5)
        # 5. Apply under-relaxation factor to stable-step the updates
        X += relaxation * delta_X

    return False, X, maxiter


def system_residuals(X_guess, X_old, dt, t_idx, params):
              """
              Evaluates ALL physical constraints simultaneously.
              X_guess: [P_0...P_9, M_0...M_8, V_contact]
              """
              Num_Nodes = params['Num_Nodes']

              # Unpacking the array
              P_guess = X_guess[0 : Num_Nodes] * 1e5
              M_guess = X_guess[Num_Nodes : - 2] * 1.0
              V_contact_guess = X_guess[-2] * 1e-3
              T_air_guess = X_guess[-1] * 1

              P_old = X_old[0 : Num_Nodes] * 1e5
              M_old = X_old[Num_Nodes : - 2] * 1.0
              V_contact_old = X_old[-2] * 1e-3
              T_air_old = X_old[-1] * 1

              residuals = []


              # Evaluating density change for all nodes
              P_new_nodes = np.clip(P_guess[1:],params["P_rho_min"],params["P_rho_max"])
              P_old_nodes = np.clip(P_old[1:],params["P_rho_min"],params["P_rho_max"])
              rho_new_nodes = params["rho_from_pressure"](P_new_nodes)
              rho_old_nodes = params["rho_from_pressure"](P_old_nodes)


              # --- PHASE A: UPDATE BRANCH MOMENTUM EQUATIONS ---

              # Calculate P_air_curr dynamically from the solver's volume guess ---
              V_air_curr = params['V_total'] - V_contact_guess
              if V_air_curr < 1e-7: V_air_curr = 1e-7 # Cushion boundary
              #P_air_curr = params['P_air_initial'] * (params['V_air_initial'] / V_air_curr)**1.4
              P_air_curr = params['mass_air'] * 287 * T_air_guess / V_air_curr

              for i in range(0, Num_Nodes-1):
                  # Calculating friction term
                  if abs(M_guess[i]) < 1e-6:
                    friction_term = 0.0
                  else:
                    G = M_guess[i] / params['A_pipe']
                    Re = abs(G) * params['D_inner'] / params['mu']
                    # Smooth Churchill approximation
                    A_ch = (-2.457 * np.log((7.0 / Re)**0.9 + 0.27 * (0.00007 / params['D_inner'])))**16
                    B_ch = (37530.0 / Re)**16
                    #f_darcy = 8.0 * ((8.0 / Re)**12 + 1.0 / (A_ch + B_ch)**1.5)**(1.0 / 12.0)                         # Chuchill
                    #f_darcy = 0.371 / (Re**(1/4))                                                                     # Measured in experiment
                    f_darcy = darcy_friction_colebrook(Re, 7e-3, 1.025*25.4, max_iter=20, tol=1e-6)                    # Colebrook equation
                    friction_term = (f_darcy * abs(M_guess[i]) * M_guess[i] * params['dx']) / (2.0 * params['D_inner'] * params['rho'] * params['A_pipe'])


                  # Momentum Balance Residual: dM/dt - Pressure_Force + Friction_Force = 0
                  if i == 0:
                      K_valve_step = 0.5 * (params["K_valve"][t_idx]+ params["K_valve"][t_idx + 1])
                      Valve_dP = K_valve_step * M_guess[i] * abs(M_guess[i])
                      dP = P_guess[i] - P_guess[i+1]
                      flow_meter_K = 0.5
                      flow_meter_resistance = flow_meter_K/(2* params['rho'] * ((params['A_pipe'])**2))
                      flow_meter_dP = flow_meter_resistance * M_guess[i] * abs(M_guess[i])
                      res_mom = ((M_guess[i] - M_old[i])*params['dx'] / dt) - (dP * params['A_pipe']) + friction_term + (Valve_dP * params['A_pipe']) + (flow_meter_dP * params['A_pipe'] )
                  elif i == Num_Nodes-2:
                      # 1. Calculate the dynamic length of final expanding cell
                      L_branch = params['dx']
                      dx_contact = V_contact_guess / params['A_pipe']
                      dx_contact_old = V_contact_old / params['A_pipe']
                      L_last_new = 0.5 * (params["dx"] + dx_contact)
                      L_last_old = 0.5 * (params["dx"] + dx_contact_old)
                      # 2. Correctly scale the transient inertia term with the dynamic cell length
                      #inertia_term = ((dx_contact * M_guess[i]) - (dx_contact_old * M_old[i])) / (dx_contact * dt)
                      inertia_term = ((L_last_new*M_guess[i]) - (L_last_old*M_old[i])) / dt
                      # 3. Source term due to force exerted by air
                      dVdt = (V_contact_guess-V_contact_old)/dt
                      Source_term = -(M_guess[i] / params['A_pipe'])* dVdt
                      L_friction = 0.5*(L_last_new + L_last_old)
                      #force_newtons = Source_term * dx_contact
                      dP = P_guess[i] - P_guess[i+1]
                      # pressure term is descaled
                      res_mom = inertia_term - (dP * params['A_pipe']) + friction_term * L_friction/params['dx'] #- Source_term

                  else:
                      dP = P_guess[i] - P_guess[i+1]
                      res_mom = ((M_guess[i] - M_old[i])*params['dx']/ dt) - (dP * params['A_pipe']) + friction_term

                  residuals.append(res_mom)


              # --- PHASE B: UPDATE NODE CONTINUITY ---
              for i in range(Num_Nodes - 2):
                  m_resident_new_i = rho_new_nodes[i] * params["V_node"]
                  m_resident_old_i = rho_old_nodes[i] * params["V_node"]
                  mass_imbalance_i = M_guess[i] - M_guess[i+1]
                  resident_mass_rate_i = (m_resident_new_i - m_resident_old_i) / dt
                  res_mass_i = mass_imbalance_i - resident_mass_rate_i
                  residuals.append(res_mass_i)


              # --- PHASE C: Forcing node 0 pressure to match tank pressure
              res_p0 = P_guess[0] - params['P_tank']
              residuals.append(res_p0)

              # Pressure equilibrium at contact
              res_p9 = P_guess[Num_Nodes-1] - P_air_curr
              residuals.append(res_p9)

              # Contact node mass balance
              m_contact_new = rho_new_nodes[-1] * V_contact_guess
              m_contact_old = rho_old_nodes[-1] * V_contact_old
              resident_mass_rate_contact = (m_contact_new - m_contact_old) / dt
              res_contact_mass = M_guess[-1] - resident_mass_rate_contact
              residuals.append(res_contact_mass)

              # Energy equation for air
              Displacement_work = -P_guess[Num_Nodes-1] * (V_contact_guess - V_contact_old) / dt
              Internal_energy_term = params['mass_air'] * params['Cv_air'] * (T_air_guess - T_air_old) / dt
              delta_T =  (params['T_wall'] - T_air_guess)
              Heat_transfer_coeff = params['alpha_natural_convection'] * (abs(delta_T)**(1/3))        # Graze (1996) natural convection model
              Heat_transfer_area = 4 * (params['V_total'] - V_contact_guess) / params['D_inner']
              Heat_transfer_term = Heat_transfer_coeff * Heat_transfer_area * delta_T
              energy_residual = Internal_energy_term + Displacement_work - Heat_transfer_term
              residuals.append(energy_residual)

              #-------------------------------------------------------------------------------
              # DIFFERENT FORMULATIONS FOR RESIDENT MASS CALCULATION
              #-------------------------------------------------------------------------------

              """volumetric_flow_in = M_guess[Num_Nodes-2] / params['rho']
              res_vol = ((V_contact_guess - V_contact_old) / dt) - volumetric_flow_in"""

              """m_water_old = V_contact_old * params['rho']
              m_water = m_water_old + M_guess[Num_Nodes-2] * dt
              if m_water < 1e-6:
                m_water = 1e-6
              P_contact = P_guess[Num_Nodes-2]
              safe_P_lookup = np.clip(P_guess[Num_Nodes-2], 1e4, 500e5)
              try:
                 # Query CoolProp dynamically inside the solver loop
                 rho_curr = CP.PropsSI('D', 'P', safe_P_lookup, 'T', 288, 'Water')
              except Exception:
                 rho_curr = params['rho']
              Z_water_curr = P_contact / (rho_curr * params['R_water'] * 288)"""

              #P_contact = P_guess[Num_Nodes-1]
              #m_water =(P_contact*V_contact_guess)/(params['Z_water'][t_idx]*params['R_water']*288)

              """beta = (params['mass_air'] * 287) / (m_water * params['R_water'] * params['Z_water'][t_idx])
              V_contact_thermo = params['V_total'] / (1.0 + beta)
              res_vol = V_contact_guess - V_contact_thermo"""

              #m_water_old = params['m_water_history'][t_idx]
              #res_continuity =(m_water - m_water_old)/dt- M_guess[Num_Nodes-2]

              #print(f"P_contact = {P_contact},Z_water_curr = {Z_water_curr}, beta = {beta}, V_contact_thermo = {V_contact_thermo}, res_vol = {res_vol}")
              """residuals.append(res_vol)"""

              #-----------------------------------------------------------------------------------------------------------------------

              residuals = np.array(residuals, dtype=float)

              #--------------------------------------------------------------------------------------
              # SCALING RESIDUALS APPROPRIATELY
              #--------------------------------------------------------------------------------------

              momentum_force_scale = (1.0e5 * params["A_pipe"])
              residuals[0 : Num_Nodes-1] /= momentum_force_scale                              # Normalize pressure/momentum residual by 10^(5)
              residuals[Num_Nodes-1 : 2*Num_Nodes-3] /= 1.0                     # Normalize internal mass continuity errors by 1.0 kg/s

              # Scale Boundary Condition residuals
              residuals[2*Num_Nodes-3] /= 1e5     # Inlet pressure error scaled by 1 bar
              residuals[2*Num_Nodes-2] /= 1e5     # Outlet air pressure error scaled by 1 bar

              # Scale Mass continuity residual for contact node
              residuals[-2] /= 1.0

              #Energy residual
              residuals[-1] /= 1.0

              return np.array(residuals)


def run_1D_fluid_flow(alpha,dt,L, D_inner, rho, a_eff, m_dot_init,m_dot_final, P_tank, T_total, Num_Nodes, T_initial, T_wall):
