def export_results_to_excel(time_array, P_history, M_history, params, h_grid, filename="simulation_output.xlsx"):
    Num_Nodes = params['Num_Nodes']

    # 1. Compile arrays into a clean structural dictionary
    export_data = {
        "Time Step": range(len(time_array)),
        "Time (s)": time_array,
        "Inlet Pressure (psi)": P_history[0, :]*14.5 / 1e5,
        "Mid-Pipe Pressure (psi)": P_history[Num_Nodes // 2, :]*14.5 / 1e5,
        "Air Pocket Pressure (psi)": P_history[Num_Nodes - 1, :]*14.5 / 1e5,
        "Interface Mass Flow (kg/s)": M_history[-1, :],
        "Interface Enthalpies" : h_grid[Num_Nodes - 1,:]
    }

    # 2. Convert dictionary into a DataFrame
    df = pd.DataFrame(export_data)

    # 3. Save directly out to a sheet configuration
    with pd.ExcelWriter(filename, engine='openpyxl') as writer:
        df.to_excel(writer, sheet_name="Transient Timeline Data", index=False)

    print(f"Successfully compiled array history and exported to {filename}")

